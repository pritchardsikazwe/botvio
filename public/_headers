/sitemap.xml
  Content-Type: application/xml

/robots.txt
  Content-Type: text/plain

/botvio-logo.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000

# Hashed asset bundles — safe to cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML & service worker — never cache so users always get the latest deploy
/
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(self)
  Content-Security-Policy: default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'self' https:; upgrade-insecure-requests
  X-XSS-Protection: 1; mode=block
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/mcp/server-card.json>; rel="mcp-server-card", </.well-known/agent-skills/index.json>; rel="agent-skills", </.well-known/oauth-authorization-server>; rel="oauth-authorization-server", </.well-known/oauth-protected-resource>; rel="oauth-protected-resource", </auth.md>; rel="auth-metadata", </sitemap.xml>; rel="sitemap", </llms.txt>; rel="llms"

/.well-known/*
  Access-Control-Allow-Origin: *

/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/oauth-authorization-server
  Content-Type: application/json

/.well-known/oauth-protected-resource
  Content-Type: application/json

/.well-known/mcp/server-card.json
  Content-Type: application/json

/.well-known/agent-skills/index.json
  Content-Type: application/json

/.well-known/http-message-signatures-directory
  Content-Type: application/http-message-signatures-directory+json

/auth.md
  Content-Type: text/markdown; charset=utf-8
